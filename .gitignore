# ---- Dependencies ----
node_modules/
*.node

# ---- Build output ----
.output/
.output-desktop/
dist/
.vercel/
.tanstack/
*.tsbuildinfo

# ---- Tauri (desktop) ----
src-tauri/target/
src-tauri/gen/schemas/
