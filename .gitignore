src-tauri/binaries/maestro-backend-*
!.desktop-shell/index.html

# ---- Generated / platform runtime ----
src/routeTree.gen.ts

# ---- Grok build tooling (agent scaffolding, not app source) ----
.grok/

# ---- Local / env / secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- QA / temp ----
screenshots/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

