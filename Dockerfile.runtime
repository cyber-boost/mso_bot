# Runtime-only image: runs a prebuilt Nitro node-server `.output/` artifact.
# The artifact is built in this repo with `npm run build` and validated for
# internal consistency (SSR asset refs == public assets) before upload. This
# avoids stale in-container build caches that can diverge CSS hashes.
FROM node:22-slim AS runtime

ENV NODE_ENV=production
ENV PORT=8080
ENV HOST=0.0.0.0
WORKDIR /app

# Expects .output/ mounted or COPY'd in (see docker-compose -f docker-compose.runtime.yml).
COPY .output .output

EXPOSE 8080
CMD ["node", ".output/server/index.mjs"]
